{
  "expo": {
    "name": "QuéFalta",
    "slug": "quefalta",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "scheme": "quefalta",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.quefalta.app",
      "associatedDomains": [
        "applinks:quefalta.es"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/icon.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.quefalta.app"
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "owner": "rruizosma",
    "extra": {
      "eas": {
        "projectId": "cdae19f5-47a5-4a4c-9f94-2befcada0885"
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/cdae19f5-47a5-4a4c-9f94-2befcada0885"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
