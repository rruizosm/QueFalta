{
  "expo": {
    "name": "QuéFalta",
    "slug": "quefalta",
    "version": "1.3.0",
    "sdkVersion": "54.0.0",
    "scheme": "quefalta",
    "orientation": "portrait",
    "icon": "./assets/quefalta-blue.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.quefalta.app",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:quefalta.es"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E1EBF7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.quefalta.app",
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "quefalta.es",
              "pathPrefix": "/join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/quefalta-blue.png"
    },
    "owner": "rruizosma",
    "extra": {
      "eas": {
        "projectId": "cdae19f5-47a5-4a4c-9f94-2befcada0885"
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/cdae19f5-47a5-4a4c-9f94-2befcada0885"
    },
    "locales": {
      "es": "./locales/ios/es.json",
      "ca": "./locales/ios/ca.json",
      "en": "./locales/ios/en.json"
    },
    "plugins": [
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "color": "#2f6cb5",
          "icon": "./assets/notification-icon.png"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E1EBF7",
          "image": "./assets/quefalta-logo-blue.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "QuéFalta only accesses your photo library when you choose to set a profile picture. For example, when you tap 'Change photo' in Edit Profile, you can pick an image from your library to use as your avatar, which is shown to your friends and shopping group members. QuéFalta does not access, collect, or upload any other photos.",
          "cameraPermission": "QuéFalta only uses the camera if you choose to take a new photo to use as your profile picture. Photos are never captured without your action.",
          "microphonePermission": "QuéFalta does not record audio. This permission is only declared because the system media picker component supports video; the app never requests it."
        }
      ]
    ]
  }
}
